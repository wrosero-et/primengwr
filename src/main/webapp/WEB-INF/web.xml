<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <!-- Nombre de la Aplicación -->
    <display-name>PrimeNG JSF Showcase</display-name>
    
    <!-- Descripción de la aplicación -->
    <description>
        Aplicación de demostración JSF con PrimeFaces y PrimeFlex.
        Implementa buenas prácticas de desarrollo Java Web.
    </description>

    <!-- Página de Bienvenida -->
    <welcome-file-list>
        <welcome-file>index.xhtml</welcome-file>
    </welcome-file-list>

    <!-- ==================== CONFIGURACIÓN JSF ==================== -->
    
    <!-- Servlet de JSF (FacesServlet) -->
    <!-- Este es el controlador principal de JSF que procesa las peticiones -->
    <servlet>
        <servlet-name>Faces Servlet</servlet-name>
        <servlet-class>javax.faces.webapp.FacesServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <!-- Mapeo del FacesServlet -->
    <!-- Todas las URLs con extensión .xhtml serán procesadas por JSF -->
    <servlet-mapping>
        <servlet-name>Faces Servlet</servlet-name>
        <url-pattern>*.xhtml</url-pattern>
    </servlet-mapping>

    <!-- ==================== PARÁMETROS DE CONTEXTO JSF ==================== -->

    <!-- PROJECT_STAGE: Define el modo de ejecución de la aplicación -->
    <!-- Development: Para desarrollo (más mensajes de error, sin caché) -->
    <!-- Production: Para producción (optimizado, con caché) -->
    <context-param>
        <param-name>javax.faces.PROJECT_STAGE</param-name>
        <param-value>Development</param-value>
    </context-param>

    <!-- Habilita el uso de CDI (Contexts and Dependency Injection) -->
    <context-param>
        <param-name>javax.faces.FACELETS_SKIP_COMMENTS</param-name>
        <param-value>true</param-value>
    </context-param>

    <!-- Configura el separador de ID para componentes -->
    <context-param>
        <param-name>javax.faces.SEPARATOR_CHAR</param-name>
        <param-value>-</param-value>
    </context-param>

    <!-- Habilita la interpretación de EL vació como null -->
    <context-param>
        <param-name>javax.faces.INTERPRET_EMPTY_STRING_SUBMITTED_VALUES_AS_NULL</param-name>
        <param-value>true</param-value>
    </context-param>

    <!-- Configura el tiempo de vida de las vistas (en minutos) -->
    <context-param>
        <param-name>javax.faces.STATE_SAVING_METHOD</param-name>
        <param-value>server</param-value>
    </context-param>

    <!-- ==================== CONFIGURACIÓN PRIMEFACES ==================== -->

    <!-- Tema de PrimeFaces -->
    <!-- Para mejor rendimiento, usa un tema compilado -->
    <context-param>
        <param-name>primefaces.THEME</param-name>
        <param-value>saga</param-value>
    </context-param>

    <!-- Habilita Font Awesome (iconos) -->
    <context-param>
        <param-name>primefaces.FONT_AWESOME</param-name>
        <param-value>true</param-value>
    </context-param>

    <!-- Configura el uploader de archivos -->
    <!-- 'auto' selecciona automáticamente entre native o commons -->
    <context-param>
        <param-name>primefaces.UPLOADER</param-name>
        <param-value>auto</param-value>
    </context-param>

    <!-- Habilita Client Side Validation -->
    <context-param>
        <param-name>primefaces.CLIENT_SIDE_VALIDATION</param-name>
        <param-value>true</param-value>
    </context-param>

    <!-- Configura el modo de guardado del estado -->
    <!-- 'true' para mejor rendimiento en producción -->
    <context-param>
        <param-name>primefaces.SUBMIT</param-name>
        <param-value>partial</param-value>
    </context-param>

    <!-- Habilita MOVE_SCRIPTS_TO_BOTTOM para mejor rendimiento -->
    <!-- Los scripts se mueven al final del body -->
    <context-param>
        <param-name>primefaces.MOVE_SCRIPTS_TO_BOTTOM</param-name>
        <param-value>true</param-value>
    </context-param>

    <!-- ==================== CONFIGURACIÓN DE SEGURIDAD ==================== -->

    <!-- Impide el acceso directo a archivos XHTML -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>XHTML Files</web-resource-name>
            <url-pattern>*.xhtml</url-pattern>
        </web-resource-collection>
        <auth-constraint />
    </security-constraint>

    <!-- Permite acceso a recursos estáticos -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Public Resources</web-resource-name>
            <url-pattern>/javax.faces.resource/*</url-pattern>
        </web-resource-collection>
    </security-constraint>

    <!-- ==================== CONFIGURACIÓN DE ERRORES ==================== -->

    <!-- Página de error 404 -->
    <error-page>
        <error-code>404</error-code>
        <location>/error/404.xhtml</location>
    </error-page>

    <!-- Página de error 500 -->
    <error-page>
        <error-code>500</error-code>
        <location>/error/500.xhtml</location>
    </error-page>

    <!-- Página de error genérica -->
    <error-page>
        <exception-type>java.lang.Exception</exception-type>
        <location>/error/500.xhtml</location>
    </error-page>

    <!-- ==================== CONFIGURACIÓN DE SESIÓN ==================== -->

    <!-- Timeout de sesión en minutos -->
    <session-config>
        <session-timeout>30</session-timeout>
        <!-- Configuración de cookies para mayor seguridad -->
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure> <!-- Cambiar a true en producción con HTTPS -->
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- ==================== FILTROS ==================== -->

    <!-- Filtro de caracteres UTF-8 -->
    <!-- Asegura que todas las peticiones y respuestas usen UTF-8 -->
    <filter>
        <filter-name>CharacterEncodingFilter</filter-name>
        <filter-class>org.omnifaces.filter.CharacterEncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CharacterEncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

</web-app>
